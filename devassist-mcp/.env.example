# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true

# --- Pick ONE agent provider (you only need a key for the agent you run) ---

# Anthropic agent -> agent/client.py
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Gemini agent -> agent/gemini_client.py  (free tier available)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- GitHub tool (optional) ---
# Works without a token for public search, but a token raises your rate limit.
# Create one at https://github.com/settings/tokens (no scopes needed for search).
GITHUB_TOKEN=
